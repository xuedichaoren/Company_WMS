/* pages/log/index.wxss —— 操作日志页样式 */

/* ==================== 顶部 ==================== */
.header {
  padding: 28rpx 24rpx 32rpx;
  background: linear-gradient(135deg, #2f6bff 0%, #4b84ff 62%, #77a4ff 100%);
  border-radius: 0 0 36rpx 36rpx;
}

.summary {
  display: flex;
}

.summary__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #ffffff;
}

.summary__value {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.summary__label {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.82;
}

/* 头部内的浅色筛选条 */
.type-tabs--light {
  margin: 28rpx 0 0;
  background: rgba(255, 255, 255, 0.18);
}

.type-tabs__item--light {
  color: rgba(255, 255, 255, 0.85);
}

.type-tabs--light .type-tabs__item--active {
  color: var(--color-primary);
  background: #ffffff;
  box-shadow: none;
}

/* ==================== 分组列表 ==================== */
.groups {
  padding: 8rpx 24rpx 0;
}

.group {
  margin-top: 24rpx;
}

.group__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
}

.group__label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.group__count {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.group__body {
  padding: 4rpx 24rpx;
  border-radius: var(--radius-card);
  background: var(--color-card);
  box-shadow: 0 8rpx 24rpx rgba(31, 42, 68, 0.05);
}

/* 单条记录 */
.rec {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.rec:last-child {
  border-bottom: none;
}

.rec--hover {
  opacity: 0.7;
}

.rec__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.rec__badge--in {
  color: var(--color-success);
  background: var(--color-success-light);
}

.rec__badge--out {
  color: var(--color-warning);
  background: var(--color-warning-light);
}

.rec__main {
  flex: 1;
  min-width: 0;
}

.rec__title {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec__meta {
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 22rpx;
  color: var(--color-text-muted);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec__qty {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.rec__qty--in {
  color: var(--color-success);
}

.rec__qty--out {
  color: var(--color-warning);
}
