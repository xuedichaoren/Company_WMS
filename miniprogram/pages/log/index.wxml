<!-- 操作日志页：类型筛选 + 日期分组 -->
<view class="screen">
  <!-- 顶部统计与筛选 -->
  <view class="header">
    <view class="summary">
      <view class="summary__item">
        <text class="summary__value">{{summary.total}}</text>
        <text class="summary__label">全部记录</text>
      </view>
      <view class="summary__item">
        <text class="summary__value">{{summary.inbound}}</text>
        <text class="summary__label">入库单</text>
      </view>
      <view class="summary__item">
        <text class="summary__value">{{summary.outbound}}</text>
        <text class="summary__label">出库单</text>
      </view>
      <view class="summary__item">
        <text class="summary__value">{{summary.pick}}</text>
        <text class="summary__label">领料条</text>
      </view>
    </view>

    <view class="type-tabs type-tabs--light">
      <view
        class="type-tabs__item type-tabs__item--light {{type === item.key ? 'type-tabs__item--active' : ''}}"
        wx:for="{{typeTabs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="handleTypeTap"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <!-- 记录分组 -->
  <view class="groups">
    <view class="group" wx:for="{{groups}}" wx:for-item="group" wx:for-index="dateIndex" wx:key="label">
      <view class="group__head">
        <text class="group__label">{{group.label}}</text>
        <text class="group__count">{{group.list.length}} 条</text>
      </view>

      <view class="group__body">
        <view
          class="rec"
          wx:for="{{group.list}}"
          wx:for-item="item"
          wx:for-index="index"
          wx:key="id"
          data-date-index="{{dateIndex}}"
          data-index="{{index}}"
          hover-class="rec--hover"
          bindtap="handleRecordTap"
        >
          <view class="rec__badge rec__badge--{{item.taskId ? 'pick' : item.type}}">{{item.typeText}}</view>

          <view class="rec__main">
            <view class="rec__title">{{item.title}}</view>
            <view class="rec__meta">{{item.sku}} · {{item.spec}}</view>
            <view class="rec__meta">{{item.time}} · {{item.operator}} · {{item.location || '未设置库位'}}</view>
            <view class="rec__remark" wx:if="{{item.remark}}">{{item.remark}}</view>
          </view>

          <view class="rec__qty rec__qty--{{item.type}}">
            {{item.type === 'in' ? '+' : '-'}}{{item.quantity}}{{item.unit}}
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{groups.length === 0}}" class="empty-state">
      <text class="empty-state__text">暂无{{type === 'in' ? '入库' : (type === 'out' ? '出库' : (type === 'pick' ? '领料' : ''))}}记录</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
