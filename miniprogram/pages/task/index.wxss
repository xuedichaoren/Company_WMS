/* pages/task/index.wxss —— 生产任务与齐套分析 */

/* ==================== 任务卡 ==================== */
.task-card {
  margin: 24rpx 24rpx 0;
  padding: 28rpx 26rpx;
  border-radius: var(--radius-card);
  background: var(--color-card);
  box-shadow: 0 8rpx 28rpx rgba(31, 42, 68, 0.06);
}

.task-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.task-card__title-wrap {
  flex: 1;
  min-width: 0;
}

.task-card__version-row {
  display: flex;
  align-items: center;
}

.task-card__version {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--color-text);
}

.task-card__badge {
  margin-left: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 21rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.task-card__badge--done {
  color: var(--color-success);
  background: var(--color-success-light);
}

/* 当前任务在队列中的位置 */
.task-card__rank-tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  color: var(--color-text-secondary);
  background: #eef2fb;
}

.task-card__name {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.task-card__switch {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.task-card__switch--hover {
  opacity: 0.7;
}

.task-card__ops {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.task-card__more {
  width: 52rpx;
  height: 42rpx;
  margin-left: 10rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 38rpx;
  text-align: center;
  color: var(--color-text-secondary);
  background: #f2f4f9;
}

.task-card__meta {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: var(--color-text-muted);
}

/* 交付日期：点击可直接改 */
.task-card__due {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: #f5f7fc;
}

.task-card__due-label {
  font-size: 21rpx;
  color: var(--color-text-secondary);
}

.task-card__due-date {
  margin-left: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
}

.task-card__due-tip {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  color: var(--color-text-secondary);
  background: #e9eefb;
}

.task-card__due-edit {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--color-primary);
}

/* 3 天内橙色，逾期红色 */
.task-card__due--soon .task-card__due-tip,
.task-card__due--today .task-card__due-tip {
  color: #b45309;
  background: #ffeccc;
}

.task-card__due--overdue {
  background: #fff1f1;
}

.task-card__due--overdue .task-card__due-date {
  color: var(--color-danger);
}

.task-card__due--overdue .task-card__due-tip {
  color: #ffffff;
  background: var(--color-danger);
}

/* 进度条 */
.progress {
  margin-top: 24rpx;
}

.progress__bar {
  height: 12rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #eef1f7;
}

.progress__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2f6bff 0%, #5c8dff 100%);
  transition: width 0.3s ease;
}

.progress__text {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 关键指标 */
.kpi-row {
  display: flex;
  margin-top: 22rpx;
  padding: 20rpx 0;
  border-radius: 20rpx;
  background: #f8faff;
}

.kpi {
  flex: 1;
  text-align: center;
}

.kpi + .kpi {
  border-left: 1rpx solid #e6ebf7;
}

.kpi__value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--color-primary);
}

.kpi--danger .kpi__value {
  color: var(--color-danger);
}

.kpi--warning .kpi__value {
  color: var(--color-warning);
}

.kpi__label {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--color-text-muted);
}

/* 提示条 */
.tip {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
  background: #f4f6fb;
}

.tip--ok {
  color: var(--color-success);
  background: var(--color-success-light);
}

.tip--danger {
  color: var(--color-danger);
  background: var(--color-danger-light);
}

.tip--warning {
  color: var(--color-warning);
  background: var(--color-warning-light);
}

/* ==================== 无任务 ==================== */
.task-empty {
  margin: 24rpx;
  padding: 60rpx 32rpx;
  border-radius: var(--radius-card);
  text-align: center;
  background: var(--color-card);
  box-shadow: 0 8rpx 28rpx rgba(31, 42, 68, 0.06);
}

.task-empty__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.task-empty__text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.task-empty__btn {
  margin: 36rpx auto 0;
  width: 420rpx;
}

/* ==================== 筛选 ==================== */
.chip-bar--scroll {
  padding: 0 24rpx;
}

.chip__count {
  margin-left: 8rpx;
  font-size: 21rpx;
  opacity: 0.75;
}

/* ==================== 物料列表 ==================== */
.list {
  padding: 8rpx 24rpx 0;
}

.mat {
  margin-top: 16rpx;
  padding: 24rpx 24rpx 22rpx;
  border-radius: 20rpx;
  background: var(--color-card);
  border-left: 6rpx solid #dfe5f0;
  box-shadow: 0 6rpx 20rpx rgba(31, 42, 68, 0.05);
}

.mat--short {
  border-left-color: var(--color-danger);
}

.mat--warn {
  border-left-color: var(--color-warning);
}

.mat--ok {
  border-left-color: var(--color-success);
}

.mat--hover {
  opacity: 0.75;
}

.mat__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mat__title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.mat__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.mat__nums {
  position: relative;
  display: flex;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--color-border);
}

.mat__num {
  flex: 1;
  text-align: center;
}

.mat__num-value {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--color-text);
}

.mat__num--danger .mat__num-value {
  color: var(--color-danger);
}

.mat__num-label {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

/* ==================== 底部按钮 ==================== */
.footer-bar__ghost {
  flex-shrink: 0;
  margin-right: 16rpx;
}

/* ==================== 采购清单 ==================== */
.purchase-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.purchase-item__main {
  flex: 1;
  min-width: 0;
}

.purchase-item__title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--color-text);
}

.purchase-item__meta {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--color-text-muted);
}

.purchase-item__right {
  flex-shrink: 0;
  margin-left: 16rpx;
  text-align: right;
}

.purchase-item__qty {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-danger);
}

.purchase-item__amount {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--color-text-muted);
}

.purchase-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.purchase-total__amount {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-danger);
}

/* 弹层内控件补充 */
.sheet__value-wrap {
  flex: 1;
  min-width: 0;
}

/* 机型版本下方的 BOM 维护直达入口 */
.sheet__link-row {
  padding: 18rpx 0 4rpx;
  font-size: 23rpx;
  color: var(--color-text-muted);
}

.sheet__link {
  color: var(--color-primary);
}

.stepper__unit {
  padding-right: 22rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 任务列表弹层 ==================== */
.tl {
  max-height: 58vh;
  padding: 8rpx 32rpx 0;
  box-sizing: border-box;
}

.tl__row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

/* 优先级序号 */
.tl__rank {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary);
  background: #e3ecff;
}

.tl__rank--top {
  color: #ffffff;
  background: var(--color-primary);
}

.tl__rank--danger {
  color: #ffffff;
  background: var(--color-danger);
}

.tl__row--hover {
  background: #f8faff;
}

.tl__row--active {
  background: #f5f8ff;
  border-radius: 16rpx;
}

.tl__main {
  flex: 1;
  min-width: 0;
}

.tl__title-row {
  display: flex;
  align-items: center;
}

.tl__version {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* 单号尾号：同版本多条任务时用来区分 */
.tl__no {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.tl__badge {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.tl__badge--done {
  color: var(--color-success);
  background: var(--color-success-light);
}

.tl__current {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.tl__meta {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--color-text-muted);
}

/* 交付日期：逾期红、3 天内橙 */
.tl__meta--due {
  font-size: 22rpx;
}

.tl__meta--soon,
.tl__meta--today {
  color: var(--color-warning);
}

.tl__meta--overdue {
  font-weight: 600;
  color: var(--color-danger);
}

.tl__meta-row {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.tl__del {
  margin-left: auto;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--color-danger);
  background: var(--color-danger-light);
}

.tl__del--hover {
  opacity: 0.65;
}

/* 手动调整优先级 */
.tl__ops {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.tl__op {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 40rpx;
  margin: 3rpx 0;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  background: #e3ecff;
}

.tl__op--off {
  color: #c3c9d6;
  background: #f0f2f7;
}

.tl__op--hover {
  opacity: 0.6;
}

.tl__empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.tl__foot {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx 8rpx;
}

/* 恢复按交付日期自动排序 */
.tl__reset {
  flex-shrink: 0;
  margin-right: 20rpx;
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--color-text-secondary);
  background: #f2f4f9;
}

.tl__reset--hover {
  opacity: 0.7;
}

.tl__create {
  flex: 1;
}

/* ==================== 任务金额 ==================== */
.task-card__amount {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #f5f8ff;
}

.task-card__amount--empty {
  background: #fff8ec;
}

.task-card__amount-main {
  display: flex;
  align-items: baseline;
}

.task-card__amount-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.task-card__amount-value {
  margin-left: auto;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.task-card__amount--empty .task-card__amount-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-warning);
}

.task-card__amount-meta {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

/* 切换弹层里的任务金额 */
.tl__amount {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.tl__meta-row .tl__del {
  margin-left: 16rpx;
}

/* 切换弹层顶部排序说明 */
.tl__sort {
  padding: 4rpx 0 18rpx;
  font-size: 21rpx;
  color: var(--color-text-muted);
}

/* ==================== 收货信息 ==================== */
.task-card__receiver {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #f7f9fc;
}

.task-card__receiver--empty {
  background: #fff8ec;
}

.task-card__receiver--hover {
  opacity: 0.85;
}

.task-card__receiver-head {
  display: flex;
  align-items: center;
}

.task-card__receiver-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.task-card__receiver-edit {
  margin-left: auto;
  font-size: 21rpx;
  color: var(--color-primary);
}

.task-card__receiver-name {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
}

.task-card__receiver-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.task-card__receiver-phone {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.task-card__receiver-addr {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.task-card__receiver-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-warning);
}

/* 弹层内分组小标题 */
.sheet__sub {
  margin: 26rpx 0 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

/* 切换弹层里的收货摘要：单行省略 */
.tl__receiver {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tl__receiver--empty {
  color: var(--color-warning);
}

/* ==================== 本单价格 ==================== */
.task-card__amount-edit {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-primary);
}

.sheet__unit {
  margin-left: 10rpx;
  font-size: 23rpx;
  color: var(--color-text-muted);
}

.price-head {
  padding: 4rpx 0 20rpx;
}

.price-head__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.price-head__sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.price-preview {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  font-size: 23rpx;
  color: var(--color-text-secondary);
  background: #f5f8ff;
}

.price-preview--muted {
  color: var(--color-text-muted);
}

.price-preview__value {
  margin-left: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.price-preview__hint {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

/* 下单日期行：比交付日期弱一档，避免抢视觉 */
.task-card__order {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background: #f7f8fb;
}
