<!-- 首页：仓库概览 / 快捷操作 / 最近操作记录 -->
<view class="page">
  <!-- ==================== 顶部概览区 ==================== -->
  <view class="hero">
    <!-- 问候语、仓库信息与扫码入口 -->
    <view class="hero__top">
      <view class="hero__user" hover-class="hero__user--hover" bindtap="handleUserTap">
        <view class="hero__greeting">{{greeting}}，{{userName}}</view>
        <view class="hero__warehouse">
          {{overview.warehouseName}} · {{userRole}}
        </view>
      </view>

      <view class="scan-btn" hover-class="scan-btn--hover" bindtap="handleScan">
        <view class="scan-btn__icon">
          <view class="scan-btn__line"></view>
        </view>
        <text class="scan-btn__text">扫一扫</text>
      </view>
    </view>

    <view class="hero__date">{{dateText}}</view>

    <!-- 数据概览：今日入库 / 今日出库 / 在库商品 / 库存预警 -->
    <view class="stat-grid">
      <view class="stat-card" wx:for="{{overview.stats}}" wx:key="key">
        <view class="stat-card__label">{{item.label}}</view>
        <view class="stat-card__value-wrap">
          <text class="stat-card__value">{{item.value}}</text>
          <text class="stat-card__unit">{{item.unit}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== 当前生产任务 ==================== -->
  <view
    class="section task-section"
    wx:if="{{taskOverview.task}}"
    hover-class="task-section--hover"
    bindtap="handleTaskTap"
  >
    <view class="section__header">
      <text class="section__title">当前任务</text>
      <text class="section__more">齐套分析 ›</text>
    </view>

    <view class="task-line">
      <text class="task-line__version">{{taskOverview.version}}</text>
      <text class="task-line__qty">× {{taskOverview.planQty}} 台</text>
      <text
        class="tag {{taskOverview.canFinish ? 'tag--success' : 'tag--danger'}} task-line__tag"
      >
        {{taskOverview.canFinish ? '物料齐套' : '物料不足'}}
      </text>
    </view>

    <view class="task-progress">
      <view class="task-progress__fill" style="width: {{taskOverview.progress}}%;"></view>
    </view>
    <view class="task-progress__text">
      已完工 {{taskOverview.doneQty}} / {{taskOverview.planQty}} 台
    </view>

    <view class="task-kpis">
      <text class="task-kpi">
        最多可做
        <text class="task-kpi__strong">{{taskOverview.maxAssemble}}</text>
        台
      </text>
      <text class="task-kpi">
        缺料
        <text class="task-kpi__danger">{{taskOverview.shortKinds}}</text>
        种
      </text>
      <text class="task-kpi">
        做完预警
        <text class="task-kpi__warning">{{taskOverview.warnKinds}}</text>
        种
      </text>
    </view>
  </view>

  <!-- 没有进行中的任务 -->
  <view class="section task-section" wx:else hover-class="task-section--hover" bindtap="handleTaskTap">
    <view class="section__header">
      <text class="section__title">当前任务</text>
      <text class="section__more">去创建 ›</text>
    </view>
    <view class="task-empty-line">暂无进行中的生产任务，点击创建并查看物料齐套</view>
  </view>

  <!-- ==================== 快捷操作 ==================== -->
  <view class="section">
    <view class="section__header">
      <text class="section__title">快捷操作</text>
      <text class="section__hint">扫码即可快速录入</text>
    </view>

    <view class="action-grid">
      <view
        class="action-item"
        wx:for="{{actions}}"
        wx:key="key"
        hover-class="action-item--hover"
        data-key="{{item.key}}"
        bindtap="handleActionTap"
      >
        <view class="action-item__icon" style="color: {{item.color}}; background: {{item.bg}};">
          {{item.icon}}
        </view>
        <text class="action-item__label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- ==================== 最近操作 ==================== -->
  <view class="section">
    <view class="section__header">
      <text class="section__title">最近操作</text>
      <text class="section__more" data-key="log" bindtap="handleActionTap">
        全部记录 ›
      </text>
    </view>

    <view class="record-list">
      <view
        class="record"
        wx:for="{{records}}"
        wx:key="key"
        hover-class="record--hover"
        data-index="{{index}}"
        bindtap="handleRecordTap"
      >
        <!-- 入库 / 出库 / 领料 类型标识 -->
        <view class="record__badge record__badge--{{item.kind}}">
          {{item.typeText}}
        </view>

        <!-- 商品与操作信息 -->
        <view class="record__main">
          <view class="record__title">{{item.title}}</view>
          <view class="record__meta">{{item.metaTop}}</view>
          <view class="record__meta">{{item.metaBottom}}</view>
        </view>

        <!-- 入库显示 +，出库 / 领料显示 -；领料按物料种数展示 -->
        <view class="record__qty record__qty--{{item.kind}}">
          {{item.qtyText}}
        </view>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{records.length === 0}}" class="empty">暂无操作记录</view>
    </view>
  </view>

  <!-- 底部安全区，适配 iPhone 等全面屏机型 -->
  <view class="safe-bottom"></view>
</view>

<!-- ==================== 领料明细弹层 ==================== -->
<view class="mask" wx:if="{{showDetail}}" bindtap="closeDetail"></view>
<view class="sheet" wx:if="{{showDetail}}" catchtap="noop">
  <view class="sheet__head">
    <text class="sheet__cancel" bindtap="closeDetail">关闭</text>
    <text class="sheet__title">{{detail.title}}</text>
    <text class="sheet__save" bindtap="goLog">日志</text>
  </view>

  <scroll-view class="sheet__body pick-body" scroll-y>
    <view class="pick-rows">
      <view class="pick-row" wx:for="{{detail.rows}}" wx:key="label">
        <text class="pick-row__label">{{item.label}}</text>
        <text class="pick-row__value">{{item.value}}</text>
      </view>
    </view>

    <view class="pick-title">领用物料（{{detail.lines.length}} 种）</view>
    <view class="pick-item" wx:for="{{detail.lines}}" wx:key="id">
      <view class="pick-item__main">
        <view class="pick-item__title">{{index + 1}}. {{item.title}}</view>
        <view class="pick-item__meta">{{item.sku}} · {{item.spec}}</view>
      </view>
      <view class="pick-item__qty">-{{item.quantity}}{{item.unit}}</view>
    </view>

    <view class="pick-remark" wx:if="{{detail.remark}}">备注：{{detail.remark}}</view>
    <view class="sheet__bottom"></view>
  </scroll-view>
</view>
