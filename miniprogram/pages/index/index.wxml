<!-- 首页：仓库概览 / 快捷操作 / 最近操作记录 -->
<view class="page">
  <!-- ==================== 顶部概览区 ==================== -->
  <view class="hero">
    <!-- 问候语、仓库信息与扫码入口 -->
    <view class="hero__top">
      <view class="hero__user" hover-class="hero__user--hover" bindtap="handleUserTap">
        <view class="hero__greeting">{{greeting}}，{{userName}}</view>
        <view class="hero__warehouse">
          {{overview.warehouseName}} · {{userRole}}
        </view>
      </view>

      <view class="scan-btn" hover-class="scan-btn--hover" bindtap="handleScan">
        <view class="scan-btn__icon">
          <view class="scan-btn__line"></view>
        </view>
        <text class="scan-btn__text">扫一扫</text>
      </view>
    </view>

    <view class="hero__date">{{dateText}}</view>

    <!-- 数据概览：今日入库 / 今日出库 / 在库商品 / 库存预警 -->
    <view class="stat-grid">
      <view class="stat-card" wx:for="{{overview.stats}}" wx:key="key">
        <view class="stat-card__label">{{item.label}}</view>
        <view class="stat-card__value-wrap">
          <text class="stat-card__value">{{item.value}}</text>
          <text class="stat-card__unit">{{item.unit}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== 生产任务（多任务同等级平铺） ==================== -->
  <view class="section">
    <view class="section__header">
      <text class="section__title">生产任务</text>
      <text class="section__more" bindtap="handleTaskManage" wx:if="{{taskBoard.total}}">
        {{taskBoard.total}} 个进行中 · 管理 ›
      </text>
      <text class="section__more" bindtap="handleTaskEmptyTap" wx:else>新建 ›</text>
    </view>
    <!-- 排序方式：交付日期 / 任务总价 / 下单时间 / 手动排序 -->
    <view class="sort-bar" wx:if="{{taskBoard.total}}">
      <view
        class="sort-chip {{item.active ? 'sort-chip--active' : ''}}"
        wx:for="{{taskBoard.sortModes}}"
        wx:key="key"
        data-mode="{{item.key}}"
        hover-class="sort-chip--hover"
        bindtap="handleSortModeTap"
      >
        {{item.label}}
      </view>
    </view>

    <view class="task-summary" wx:if="{{taskBoard.total}}">
      <text>合计金额 {{taskBoard.totalAmountText}}</text>
      <text class="task-summary__hint" wx:if="{{taskBoard.sortMode === 'manual'}}">长按卡片可改序号</text>
      <text class="task-summary__hint" wx:else>长按卡片可手动排序</text>
    </view>

    <view class="task-list" wx:if="{{taskBoard.total}}">
      <view
        class="tcard tcard--{{item.dueLevel}}"
        wx:for="{{taskBoard.tasks}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-index="{{index}}"
        hover-class="tcard--hover"
        bindtap="handleTaskTap"
        bindlongpress="handleTaskLongPress"
      >
        <!-- 优先级序号：手动排序模式下高亮，长按卡片可改 -->
        <view
          class="tcard__rank {{taskBoard.sortMode === 'manual' ? 'tcard__rank--manual' : ''}} {{item.dueLevel === 'overdue' ? 'tcard__rank--danger' : (item.priority === 1 ? 'tcard__rank--top' : '')}}"
        >
          {{item.priority}}
        </view>

        <view class="tcard__body">
          <view class="tcard__row">
            <text class="tcard__version">{{item.version}}</text>
            <text class="tcard__qty">× {{item.planQty}} 台</text>
            <text class="tcard__no">#{{item.idShort}}</text>
            <text
              class="tag {{item.summary.canFinish ? 'tag--success' : 'tag--danger'}} tcard__tag"
              wx:if="{{item.summary}}"
            >
              {{item.summary.canFinish ? '物料齐套' : '物料不足'}}
            </text>
            <text class="tag tag--warning tcard__tag" wx:else>无 BOM</text>
          </view>

          <!-- 交付日期 + 任务总价 -->
          <view class="tcard__meta-row">
            <view class="tcard__due tcard__due--{{item.dueLevel}}">
              <text class="tcard__due-date">{{item.dueFull}}</text>
              <text class="tcard__due-tip">{{item.dueTip}}</text>
            </view>
            <view class="tcard__amount">
              <text class="tcard__amount-value">{{item.amountText}}</text>
              <text class="tcard__amount-meta">本单 {{item.unitPriceText}} × {{item.planQty}} 台</text>
            </view>
          </view>

          <view class="tcard__bar">
            <view class="tcard__bar-fill" style="width: {{item.progress}}%;"></view>
          </view>

          <view class="tcard__nums" wx:if="{{item.summary}}">
            <text class="tcard__num">已完工 {{item.doneQty}}/{{item.planQty}}</text>
            <text class="tcard__num">可做 {{item.summary.maxAssemble}} 台</text>
            <text class="tcard__num {{item.summary.shortKinds ? 'tcard__num--danger' : ''}}">
              缺料 {{item.summary.shortKinds}}
            </text>
            <text class="tcard__num {{item.summary.warnKinds ? 'tcard__num--warning' : ''}}">
              预警 {{item.summary.warnKinds}}
            </text>
          </view>

          <!-- 收货信息：一行省略，点卡片进任务页可看全 -->
          <view class="tcard__receiver {{item.hasReceiver ? '' : 'tcard__receiver--empty'}}" wx:if="{{item.hasReceiver}}">
            <text class="tcard__receiver-label">收货</text>
            <text class="tcard__receiver-text">{{item.receiverTitle || '未填收货人'}} · {{item.addressText || '未填地址'}}</text>
          </view>
          <view class="tcard__receiver tcard__receiver--empty" wx:else>
            <text class="tcard__receiver-label">收货</text>
            <text class="tcard__receiver-text">收货信息待填</text>
          </view>
        </view>

        <!-- 手动调整优先级：任务多于一个时才出现 -->
        <view class="tcard__ops" wx:if="{{taskBoard.total > 1}}">
          <view
            class="tcard__op {{item.canMoveUp ? '' : 'tcard__op--off'}}"
            data-id="{{item.id}}"
            data-dir="up"
            hover-class="tcard__op--hover"
            catchtap="handleTaskMove"
          >↑</view>
          <view
            class="tcard__op {{item.canMoveDown ? '' : 'tcard__op--off'}}"
            data-id="{{item.id}}"
            data-dir="down"
            hover-class="tcard__op--hover"
            catchtap="handleTaskMove"
          >↓</view>
        </view>
      </view>

      <!-- 逾期 / 缺料提醒 -->
      <view class="task-hint" wx:if="{{taskBoard.overdueCount || taskBoard.shortCount}}">
        <text class="task-hint__danger" wx:if="{{taskBoard.overdueCount}}">
          {{taskBoard.overdueCount}} 个任务已逾期
        </text>
        <text wx:if="{{taskBoard.overdueCount && taskBoard.shortCount}}"> · </text>
        <text class="task-hint__warning" wx:if="{{taskBoard.shortCount}}">
          {{taskBoard.shortCount}} 个任务缺料
        </text>
      </view>
    </view>

    <!-- 没有进行中的任务：没维护 BOM 时先去建 BOM，否则去新建任务 -->
    <view class="task-empty" wx:else hover-class="task-empty--hover" bindtap="handleTaskEmptyTap">
      <view class="task-empty__title">
        {{bomCount ? '暂无进行中的生产任务' : '还没有机型 BOM'}}
      </view>
      <view class="task-empty__tip">
        {{bomCount ? '新建任务后会自动按 BOM 计算物料齐套情况' : '先维护机型版本与物料清单，再下生产任务'}}
      </view>
      <view class="task-empty__btn">{{bomCount ? '＋ 新建生产任务' : '＋ 去维护 BOM'}}</view>
    </view>
  </view>

  <!-- ==================== 快捷操作 ==================== -->
  <view class="section">
    <view class="section__header">
      <text class="section__title">快捷操作</text>
      <text class="section__hint">扫码即可快速录入</text>
    </view>

    <view class="action-grid">
      <view
        class="action-item"
        wx:for="{{actions}}"
        wx:key="key"
        hover-class="action-item--hover"
        data-key="{{item.key}}"
        bindtap="handleActionTap"
      >
        <view class="action-item__icon" style="color: {{item.color}}; background: {{item.bg}};">
          {{item.icon}}
        </view>
        <text class="action-item__label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- ==================== 最近操作 ==================== -->
  <view class="section">
    <view class="section__header">
      <text class="section__title">最近操作</text>
      <text class="section__more" data-key="log" bindtap="handleActionTap">
        全部记录 ›
      </text>
    </view>

    <view class="record-list">
      <view
        class="record"
        wx:for="{{records}}"
        wx:key="key"
        hover-class="record--hover"
        data-index="{{index}}"
        bindtap="handleRecordTap"
      >
        <!-- 入库 / 出库 / 领料 类型标识 -->
        <view class="record__badge record__badge--{{item.kind}}">
          {{item.typeText}}
        </view>

        <!-- 商品与操作信息 -->
        <view class="record__main">
          <view class="record__title">{{item.title}}</view>
          <view class="record__meta">{{item.metaTop}}</view>
          <view class="record__meta">{{item.metaBottom}}</view>
        </view>

        <!-- 入库显示 +，出库 / 领料显示 -；领料按物料种数展示 -->
        <view class="record__qty record__qty--{{item.kind}}">
          {{item.qtyText}}
        </view>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{records.length === 0}}" class="empty">暂无操作记录</view>
    </view>
  </view>

  <!-- 底部安全区，适配 iPhone 等全面屏机型 -->
  <view class="safe-bottom"></view>
</view>

<!-- ==================== 领料明细弹层 ==================== -->
<view class="mask" wx:if="{{showDetail}}" bindtap="closeDetail"></view>
<view class="sheet" wx:if="{{showDetail}}" catchtap="noop">
  <view class="sheet__head">
    <text class="sheet__cancel" bindtap="closeDetail">关闭</text>
    <text class="sheet__title">{{detail.title}}</text>
    <text class="sheet__save" bindtap="goLog">日志</text>
  </view>

  <scroll-view class="sheet__body pick-body" scroll-y>
    <view class="pick-rows">
      <view class="pick-row" wx:for="{{detail.rows}}" wx:key="label">
        <text class="pick-row__label">{{item.label}}</text>
        <text class="pick-row__value">{{item.value}}</text>
      </view>
    </view>

    <view class="pick-title">领用物料（{{detail.lines.length}} 种）</view>
    <view class="pick-item" wx:for="{{detail.lines}}" wx:key="id">
      <view class="pick-item__main">
        <view class="pick-item__title">{{index + 1}}. {{item.title}}</view>
        <view class="pick-item__meta">{{item.sku}} · {{item.spec}}</view>
      </view>
      <view class="pick-item__qty">-{{item.quantity}}{{item.unit}}</view>
    </view>

    <view class="pick-remark" wx:if="{{detail.remark}}">备注：{{detail.remark}}</view>
    <view class="sheet__bottom"></view>
  </scroll-view>
</view>

<!-- ==================== 手动优先级弹层（长按任务卡） ==================== -->
<view class="mask" wx:if="{{showPriority}}" bindtap="closePriority"></view>
<view class="sheet" wx:if="{{showPriority}}" catchtap="noop">
  <view class="sheet__head">
    <text class="sheet__cancel" bindtap="closePriority">关闭</text>
    <text class="sheet__title">调整优先级</text>
    <text class="sheet__save" bindtap="closePriority">完成</text>
  </view>

  <scroll-view class="sheet__body pri-body" scroll-y>
    <view class="pri-head">
      <text class="pri-head__title">{{priorityTask.version}} × {{priorityTask.planQty}} 台</text>
      <text class="pri-head__sub">当前第 {{priorityTask.priority}} 位，点数字直接排到该位置</text>
    </view>

    <view class="pri-grid">
      <view
        class="pri-item {{item === priorityTask.priority ? 'pri-item--active' : ''}}"
        wx:for="{{priorityList}}"
        wx:key="*this"
        data-pos="{{item}}"
        hover-class="pri-item--hover"
        bindtap="handlePriorityPick"
      >
        {{item}}
      </view>
    </view>

    <view class="sheet__tips">调整后自动切到「手动排序」，之后的顺序不会被日期改动冲掉</view>
    <view class="sheet__bottom"></view>
  </scroll-view>
</view>
