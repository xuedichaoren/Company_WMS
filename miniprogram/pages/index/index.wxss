/* pages/index/index.wxss —— 首页样式 */

.page {
  min-height: 100vh;
  padding-bottom: 24rpx;
  background: var(--color-bg);
}

/* ==================== 顶部概览区 ==================== */
.hero {
  padding: 36rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #2f6bff 0%, #4b84ff 60%, #77a4ff 100%);
  border-radius: 0 0 40rpx 40rpx;
  color: #ffffff;
}

.hero__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero__user {
  min-width: 0;
}

.hero__user--hover {
  opacity: 0.75;
}

.hero__greeting {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.3;
}

.hero__warehouse {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

/* 扫码按钮 */
.scan-btn {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.2);
}

.scan-btn--hover {
  background: rgba(255, 255, 255, 0.34);
}

/* 用纯 CSS 绘制一个简易扫码框图标 */
.scan-btn__icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  border: 3rpx solid #ffffff;
  border-radius: 6rpx;
}

.scan-btn__line {
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 50%;
  height: 2rpx;
  background: #ffffff;
  transform: translateY(-50%);
}

.scan-btn__text {
  font-size: 24rpx;
  font-weight: 500;
}

.hero__date {
  margin-top: 18rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

/* 数据卡片：两列布局 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 30rpx;
}

.stat-card {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  background: rgba(255, 255, 255, 0.16);
}

.stat-card:nth-last-child(-n + 2) {
  margin-bottom: 0;
}

.stat-card__label {
  font-size: 24rpx;
  opacity: 0.85;
}

.stat-card__value-wrap {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.stat-card__value {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stat-card__unit {
  margin-left: 8rpx;
  font-size: 22rpx;
  opacity: 0.8;
}

/* ==================== 通用卡片区块 ==================== */
.section {
  margin: 24rpx 24rpx 0;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-card);
  background: var(--color-card);
  box-shadow: 0 8rpx 28rpx rgba(31, 42, 68, 0.06);
}

.section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.section__hint {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.section__more {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 快捷操作 ==================== */
.action-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 26rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 33.333%;
  padding: 14rpx 0;
}

.action-item--hover {
  opacity: 0.65;
}

.action-item__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.action-item__label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #3b4252;
  white-space: nowrap;
}

/* ==================== 最近操作 ==================== */
.record-list {
  margin-top: 10rpx;
}

.record {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f2f7;
}

.record:last-child {
  padding-bottom: 4rpx;
  border-bottom: none;
}

.record--hover {
  opacity: 0.7;
}

.record__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.record__badge--in {
  color: var(--color-success);
  background: #e8f8ee;
}

.record__badge--out {
  color: var(--color-warning);
  background: #fff2e8;
}

/* 生产领料：与普通出库区分开 */
.record__badge--pick {
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.record__main {
  flex: 1;
  min-width: 0;
}

.record__title {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record__meta {
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 22rpx;
  color: var(--color-text-muted);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record__qty {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.record__qty--in {
  color: var(--color-success);
}

.record__qty--out {
  color: var(--color-warning);
}

/* 领料按「种」展示，用主色与出库区分 */
.record__qty--pick {
  font-size: 26rpx;
  color: var(--color-primary);
}

.empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-muted);
}

/* ==================== 生产任务列表 ==================== */
.task-list {
  margin-top: 4rpx;
}

.tcard {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 20rpx 18rpx;
  border-left: 6rpx solid var(--color-primary);
  border-radius: 22rpx;
  background: #f7f9ff;
}

.tcard--hover {
  opacity: 0.82;
}

/* 交付日期越近，左边条与底色越醒目 */
.tcard--soon {
  border-left-color: var(--color-warning);
  background: #fff9ef;
}

.tcard--today {
  border-left-color: var(--color-warning);
  background: #fff5e4;
}

.tcard--overdue {
  border-left-color: var(--color-danger);
  background: #fff1f1;
}

.tcard--none {
  border-left-color: #c9cfdb;
  background: #f6f7fb;
}

/* 优先级序号 */
.tcard__rank {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
  background: #e3ecff;
}

.tcard__rank--top {
  color: #ffffff;
  background: var(--color-primary);
}

.tcard__rank--danger {
  color: #ffffff;
  background: var(--color-danger);
}

.tcard__body {
  flex: 1;
  min-width: 0;
}

.tcard__row {
  display: flex;
  align-items: center;
}

.tcard__version {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.tcard__qty {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 单号尾号：同版本多条任务时用来区分 */
.tcard__no {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.tcard__tag {
  margin-left: auto;
  transform: scale(0.9);
  transform-origin: right center;
}

/* 交付日期 */
.tcard__due {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--color-text-muted);
}

.tcard__due-date {
  margin-right: 10rpx;
}

.tcard__due-tip {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  background: #eef2fb;
}

.tcard__due--soon .tcard__due-tip,
.tcard__due--today .tcard__due-tip {
  color: #b45309;
  background: #ffeccc;
}

.tcard__due--overdue .tcard__due-date {
  color: var(--color-danger);
  font-weight: 600;
}

.tcard__due--overdue .tcard__due-tip {
  color: #ffffff;
  background: var(--color-danger);
}

/* 进度条 */
.tcard__bar {
  height: 8rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8ecf5;
}

.tcard__bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2f6bff 0%, #5c8dff 100%);
}

/* 齐套指标 */
.tcard__nums {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.tcard__num {
  margin-right: 16rpx;
}

.tcard__num--danger {
  font-weight: 600;
  color: var(--color-danger);
}

.tcard__num--warning {
  font-weight: 600;
  color: var(--color-warning);
}

/* 手动调整优先级 */
.tcard__ops {
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 12rpx;
}

.tcard__op {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 42rpx;
  margin: 3rpx 0;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  background: #e3ecff;
}

.tcard__op--off {
  color: #c3c9d6;
  background: #f0f2f7;
}

.tcard__op--hover {
  opacity: 0.6;
}

.task-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.task-hint__danger {
  color: var(--color-danger);
}

.task-hint__warning {
  color: var(--color-warning);
}

.task-empty {
  margin-top: 20rpx;
  padding: 34rpx 28rpx;
  border: 1rpx dashed var(--color-border);
  border-radius: 20rpx;
  background: #fafbfe;
  text-align: center;
}

.task-empty--hover {
  opacity: 0.75;
}

.task-empty__title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--color-text);
}

.task-empty__tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-muted);
}

.task-empty__btn {
  display: inline-block;
  margin-top: 22rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #fff;
  background: var(--color-primary);
}

/* 底部安全区 */
.safe-bottom {
  height: 24rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ==================== 领料明细弹层 ==================== */
.pick-body {
  max-height: calc(82vh - 96rpx);
}

.pick-rows {
  padding: 16rpx 0 8rpx;
}

.pick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2f4f8;
}

.pick-row__label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.pick-row__value {
  max-width: 62%;
  overflow: hidden;
  font-size: 26rpx;
  color: var(--color-text);
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-title {
  margin: 26rpx 0 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.pick-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f6fa;
}

.pick-item__main {
  flex: 1;
  min-width: 0;
}

.pick-item__title {
  overflow: hidden;
  font-size: 26rpx;
  color: var(--color-text);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-item__meta {
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 22rpx;
  color: var(--color-text-muted);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-item__qty {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.pick-remark {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}
