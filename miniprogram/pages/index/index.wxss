/* pages/index/index.wxss —— 首页样式 */

.page {
  min-height: 100vh;
  padding-bottom: 24rpx;
  background: var(--color-bg);
}

/* ==================== 顶部概览区 ==================== */
.hero {
  padding: 36rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #2f6bff 0%, #4b84ff 60%, #77a4ff 100%);
  border-radius: 0 0 40rpx 40rpx;
  color: #ffffff;
}

.hero__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero__greeting {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.3;
}

.hero__warehouse {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

/* 扫码按钮 */
.scan-btn {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.2);
}

.scan-btn--hover {
  background: rgba(255, 255, 255, 0.34);
}

/* 用纯 CSS 绘制一个简易扫码框图标 */
.scan-btn__icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  border: 3rpx solid #ffffff;
  border-radius: 6rpx;
}

.scan-btn__line {
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 50%;
  height: 2rpx;
  background: #ffffff;
  transform: translateY(-50%);
}

.scan-btn__text {
  font-size: 24rpx;
  font-weight: 500;
}

.hero__date {
  margin-top: 18rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

/* 数据卡片：两列布局 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 30rpx;
}

.stat-card {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  background: rgba(255, 255, 255, 0.16);
}

.stat-card:nth-last-child(-n + 2) {
  margin-bottom: 0;
}

.stat-card__label {
  font-size: 24rpx;
  opacity: 0.85;
}

.stat-card__value-wrap {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.stat-card__value {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stat-card__unit {
  margin-left: 8rpx;
  font-size: 22rpx;
  opacity: 0.8;
}

/* ==================== 通用卡片区块 ==================== */
.section {
  margin: 24rpx 24rpx 0;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-card);
  background: var(--color-card);
  box-shadow: 0 8rpx 28rpx rgba(31, 42, 68, 0.06);
}

.section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.section__hint {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.section__more {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 快捷操作 ==================== */
.action-grid {
  display: flex;
  margin-top: 26rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20%;
  padding: 6rpx 0;
}

.action-item--hover {
  opacity: 0.65;
}

.action-item__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.action-item__label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #3b4252;
  white-space: nowrap;
}

/* ==================== 最近操作 ==================== */
.record-list {
  margin-top: 10rpx;
}

.record {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f2f7;
}

.record:last-child {
  padding-bottom: 4rpx;
  border-bottom: none;
}

.record--hover {
  opacity: 0.7;
}

.record__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.record__badge--in {
  color: var(--color-success);
  background: #e8f8ee;
}

.record__badge--out {
  color: var(--color-warning);
  background: #fff2e8;
}

.record__main {
  flex: 1;
  min-width: 0;
}

.record__title {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record__meta {
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 22rpx;
  color: var(--color-text-muted);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record__qty {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.record__qty--in {
  color: var(--color-success);
}

.record__qty--out {
  color: var(--color-warning);
}

.empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-muted);
}

/* 底部安全区 */
.safe-bottom {
  height: 24rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
