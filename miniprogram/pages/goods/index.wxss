/* pages/goods/index.wxss —— 商品管理页样式 */

/* ==================== 顶部 ==================== */
.header {
  padding: 24rpx 24rpx 28rpx;
  background: linear-gradient(135deg, #2f6bff 0%, #4b84ff 62%, #77a4ff 100%);
  border-radius: 0 0 32rpx 32rpx;
}

.header__row {
  display: flex;
  align-items: center;
}

.header__search {
  flex: 1;
  min-width: 0;
  box-shadow: none;
}

.header__add {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.header__add--hover {
  background: rgba(255, 255, 255, 0.36);
}

.header__add-icon {
  font-size: 40rpx;
  line-height: 1;
  color: #ffffff;
}

.header__sub {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ==================== 筛选 ==================== */
.chip-bar--scroll {
  padding: 0 24rpx;
}

/* ==================== 商品条目 ==================== */
.list {
  padding: 8rpx 24rpx 0;
}

.item {
  margin-top: 20rpx;
  padding: 26rpx 24rpx 20rpx;
  border-radius: var(--radius-card);
  background: var(--color-card);
  box-shadow: 0 8rpx 24rpx rgba(31, 42, 68, 0.05);
}

.item--hover {
  opacity: 0.78;
}

.item__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item__title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--color-text);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item__meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--color-text-muted);
}

.item__tags {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.item__stock {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.item__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.item__loc {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 22rpx;
  color: var(--color-text-muted);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item__ops {
  display: flex;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.item__op {
  padding: 8rpx 22rpx;
  margin-left: 12rpx;
  border-radius: 999rpx;
  background: #f2f4f9;
  font-size: 23rpx;
  color: var(--color-primary);
}

.item__op--danger {
  color: var(--color-danger);
  background: var(--color-danger-light);
}

/* ==================== 底部弹层 ==================== */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  background: rgba(15, 23, 42, 0.45);
  animation: mask-in 0.2s ease;
}

@keyframes mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 31;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  animation: sheet-in 0.24s ease;
}

@keyframes sheet-in {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 32rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.sheet__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.sheet__cancel {
  font-size: 27rpx;
  color: var(--color-text-secondary);
}

.sheet__save {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.sheet__body {
  flex: 1;
  max-height: calc(82vh - 96rpx);
  padding: 0 32rpx;
}

.sheet__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.sheet__label {
  flex-shrink: 0;
  width: 190rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.sheet__req {
  color: var(--color-danger);
}

.sheet__input {
  flex: 1;
  min-width: 0;
  height: 52rpx;
  font-size: 27rpx;
  color: var(--color-text);
  text-align: right;
}

.sheet__placeholder {
  color: #c2c9d6;
  font-size: 26rpx;
}

.sheet__value {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  text-align: right;
  color: var(--color-text);
}

.sheet__tips {
  padding: 24rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.sheet__bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}
