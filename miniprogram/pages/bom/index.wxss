/* pages/bom/index.wxss —— BOM 维护页 */

/* ==================== 顶部 ==================== */
.header {
  padding: 32rpx 24rpx 28rpx;
  background: linear-gradient(135deg, #2f6bff 0%, #4b84ff 62%, #77a4ff 100%);
  border-radius: 0 0 32rpx 32rpx;
}

.header__title {
  font-size: 38rpx;
  font-weight: 600;
  color: #ffffff;
}

.header__sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.85);
}

.chip-bar--scroll {
  margin-top: 22rpx;
}

.chip--add {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: none;
}

/* ==================== 版本信息 ==================== */
.ver {
  flex: 1;
  min-width: 0;
}

.ver__version {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}

.ver__name {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.ver__meta {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--color-text-secondary);
}

.ver__remark {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.ver__actions {
  display: flex;
  margin-top: 24rpx;
}

.ver__btn {
  flex: 1;
}

.ver__btn + .ver__btn {
  margin-left: 16rpx;
}

/* ==================== 无版本 ==================== */
.empty-bom {
  padding: 56rpx 32rpx;
  text-align: center;
}

.empty-bom__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.empty-bom__text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-muted);
}

.empty-bom__btn {
  margin: 32rpx auto 0;
  width: 340rpx;
}

/* ==================== 物料清单 ==================== */
.list-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 24rpx 4rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.list-title__hint {
  font-size: 21rpx;
  font-weight: 400;
  color: var(--color-text-muted);
}

.list {
  padding: 0 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: var(--color-card);
  box-shadow: 0 6rpx 20rpx rgba(31, 42, 68, 0.05);
}

.row--hover {
  opacity: 0.7;
}

.row__main {
  flex: 1;
  min-width: 0;
}

.row__title {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 500;
  color: var(--color-text);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__meta {
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 21rpx;
  color: var(--color-text-muted);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__nums {
  flex-shrink: 0;
  margin-left: 20rpx;
  text-align: right;
}

.row__qty {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.row__stock {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

/* ==================== 弹层补充 ==================== */
.sheet__search {
  margin-top: 24rpx;
  background: #f4f6fb;
  box-shadow: none;
}

.sheet__danger {
  margin-top: 40rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 27rpx;
  color: var(--color-danger);
}

.import-tips {
  margin-top: 24rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.import-demo {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: #f4f6fb;
  font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--color-text-muted);
  white-space: pre-wrap;
}

.import-area {
  width: 100%;
  height: 300rpx;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border);
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text);
}
